}

func (h *{{.Entity}}Handler) UpdateByID(c echo.Context) error {
	id, err := uuid.Parse(c.Param(oneword.UUID))
	if err != nil {
		return c.String(http.StatusBadRequest, err.Error())
	}
	params := new(repo.{{.Entity}}Params)
	if err := c.Bind(params); err != nil {
		return err
	}
	record, err := h.{{.Entity}}Repository.Update(id, *params)
	if err != nil {
		return c.String(http.StatusBadRequest, err.Error())
	}
