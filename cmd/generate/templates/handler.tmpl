	{{.Entity}}Service    *service.{{.Entity}}Service
	{{.Entity}}Repository *repo.{{.Entity}}Repository
}

func New{{.Entity}}Handler() *{{.Entity}}Handler {
	return &{{.Entity}}Handler{
		{{.Entity}}Service:    service.New{{.Entity}}Service(),
		{{.Entity}}Repository: repo.New{{.Entity}}Repository(),
	}
}

func (*{{.Entity}}Handler) ResourceName() string {
	return {{.FileName}}
}

func (h *{{.Entity}}Handler) ReadAll(c echo.Context) error {
